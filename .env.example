# Existing RedMan host app-data directory. Do not point this at a new empty path.
REDMAN_DATA_PATH=/srv/redman

# Bind the bridge to loopback unless your reverse proxy needs another interface.
REDMAN_WEB_BIND=127.0.0.1
REDMAN_WEB_PORT=8090

# Exact source address RedMan sees from the trusted reverse proxy.
# Production accepts bare host IPs, IPv4 /32, or IPv6 /128 only.
TRUSTED_PROXIES=127.0.0.1/32

# Set at least one exact forward-auth group or role permitted to create readiness backups and plans.
# Pangolin Badger sends Remote-Role; Authelia commonly sends Remote-Groups.
REDMAN_ADMIN_GROUP=
REDMAN_ADMIN_ROLE=
