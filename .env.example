# Required host paths. Run scripts/setup-backup-user.sh with REDMAN_DATA_PATH
# before starting Compose so the authorized_keys bind source exists as a file.
REDMAN_DATA_PATH=/srv/redman
REDMAN_STORAGE_PATH=/srv/redman-backups
REDMAN_MEDIA_PATH=/media
REDMAN_HOST_AUTHORIZED_KEYS_PATH=/srv/redman/ssh-keys/authorized_keys
REDMAN_WEB_BIND=127.0.0.1
REDMAN_WEB_PORT=8090
REDMAN_PEER_BIND=192.168.1.20
REDMAN_PEER_PUBLISHED_PORT=8091

# Compose/runtime limits. On Unraid, manage equivalent values in DockerMan.
# RedMan reads its effective cgroup limits and adapts heavy work at runtime.
REDMAN_MEMORY_LIMIT=1536m
REDMAN_MEMORY_SWAP_LIMIT=2048m
REDMAN_CPU_LIMIT=2
REDMAN_PIDS_LIMIT=256

# Main API authentication. Use an exact HTTPS origin in production.
AUTH_MODE=local
REDMAN_PUBLIC_ORIGIN=https://redman.example.com
TRUSTED_PROXIES=127.0.0.1/32
PROXY_AUTO_PROVISION_ROLE=
REDMAN_BOOTSTRAP_TOKEN=

# Optional fail-closed maintenance mode. When enabled, schedules and the peer
# API pause; configure at least one exact bridge administrator authority.
REDMAN_UPGRADE_BRIDGE=false
REDMAN_ADMIN_GROUP=
REDMAN_ADMIN_ROLE=

# Numeric private address on this host that the other RedMan peer can reach.
PEER_HOST=192.168.1.20
TZ=UTC

# Optional. Enable the Compose docker-monitoring profile and set both endpoints.
DOCKER_HOST=
DOCKER_CONTROL_HOST=
